# Copy this file to .env (cp .env.example .env) and fill in the key. Never commit .env.

# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: uncomment to override the defaults.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash    # set it empty to switch the fallback off
# SECRET_KEY=                               # Flask session key; a random one is made at each start if unset
# PORT=8000
